{
  "contract": "fastctx.claude-jsonl-framing.v1",
  "notes": [
    "Synthetic Claude rows freeze JSON framing, Unicode escapes, field-order-independent image classification and the authorized stable-seal rule. align_token is placed at byte 65535 by space-prefixing the row; the test uses 1-, 7- and 65536-byte windows and serialized restart.",
    "These samples freeze semantic framing, not the private checkpoint or manifest-tree encoding.",
    "An invalid row preserves evidence but never produces a validated document.",
    "raw_sha256 covers preserved row bytes without the JSONL LF. Each align_tokens entry is independently aligned across a real 65536-byte input boundary."
  ],
  "cases": [
    {
      "name": "utf8-escape-boundaries",
      "input": "{\"type\":\"assistant\",\"uuid\":\"fixture-message\",\"timestamp\":\"2026-01-01T00:00:00Z\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"中🙂\\n\\uD834\\uDD1E\"}]}}\n",
      "expected": {
        "type": "assistant",
        "uuid": "fixture-message",
        "timestamp": "2026-01-01T00:00:00Z",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "中🙂\n𝄞"
            }
          ]
        }
      },
      "valid_while_following": 1,
      "valid_after_stable_seal": 1,
      "invalid_rows": 0,
      "raw_sha256": "45ca5b8d3612b665af1bc5f98a77416fca27a28858964b9ca1aae88f03906976",
      "align_tokens": [
        "中",
        "🙂",
        "\\uD834",
        "\\uDD1E"
      ]
    },
    {
      "name": "sealed-image-tail",
      "input": "{\"type\":\"user\",\"uuid\":\"fixture-image\",\"timestamp\":\"2026-01-01T00:00:00Z\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"image\",\"source\":{\"type\":\"base64\",\"media_type\":\"image/png\",\"data\":\"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jB7sAAAAASUVORK5CYII=\"}}]}}",
      "expected": {
        "type": "user",
        "uuid": "fixture-image",
        "timestamp": "2026-01-01T00:00:00Z",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "image",
              "source": {
                "type": "base64",
                "media_type": "image/png",
                "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jB7sAAAAASUVORK5CYII="
              }
            }
          ]
        }
      },
      "valid_while_following": 0,
      "valid_after_stable_seal": 1,
      "invalid_rows": 0,
      "raw_sha256": "96244f4786ce83474779bbef428bd725f6128857ac696eefe543b3cc0bced9aa",
      "image_sha256": "6f3c1013e92c72e492909f6b96537f4064b92af63873bcde214da4705310e2f8",
      "align_tokens": [
        "iVBORw"
      ]
    },
    {
      "name": "invalid-trailing-bytes",
      "input": "{\"type\":\"assistant\"} trailing\n",
      "expected": null,
      "valid_while_following": 0,
      "valid_after_stable_seal": 0,
      "invalid_rows": 1,
      "raw_sha256": "684efa7b66efcb232d709590829c7fdd4540d918322b137b02f26ef5b185af91",
      "align_tokens": []
    },
    {
      "name": "image-data-before-type",
      "input": "{\"message\":{\"content\":[{\"source\":{\"data\":\"aGVsbG8=\",\"media_type\":\"image/png\",\"type\":\"base64\"},\"type\":\"image\"}]},\"type\":\"user\"}\n",
      "expected": {
        "message": {
          "content": [
            {
              "source": {
                "data": "aGVsbG8=",
                "media_type": "image/png",
                "type": "base64"
              },
              "type": "image"
            }
          ]
        },
        "type": "user"
      },
      "valid_while_following": 1,
      "valid_after_stable_seal": 1,
      "invalid_rows": 0,
      "raw_sha256": "581e0947140c849373c52189ea5d3e04e2d042e94e17806945e9f59b4c9eede0",
      "image_sha256": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
      "align_tokens": [
        "aGVsbG8="
      ]
    }
  ]
}
