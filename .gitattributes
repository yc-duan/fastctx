# Shell scripts run on Linux and in WSL; keep them LF on every checkout.
*.sh text eol=lf
/gui/scripts/AppRun text eol=lf
# The contract check compares serde's generated output byte for byte.
gui/fixtures/wire.json text eol=lf
# Embedded legal texts must have the same bytes in every release checkout.
/LICENSE-APACHE text eol=lf
/dist/THIRD_PARTY_LICENSES.md text eol=lf
/NOTICE text eol=lf
/licenses/** text eol=lf
/gui/licenses/** text eol=lf
/gui/licenses/linux-runtime/*.gz binary
# Embedded agent defaults retain the supplied bytes on every checkout.
/crates/fastctx-types/src/profile/agent-defaults/*.md text eol=lf
