<?xml version="1.0" encoding="utf-8"?>
<!-- The window and the system's splash are the page's own colour from the first frame: the
     system's light or dark here, and a chosen theme once WorldFrame has named it for the splash. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.fastctx_gui" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/world_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/world_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowDisablePreview">@bool/world_disable_preview</item>
    </style>
    <style name="Theme.World.WarmBlack" parent="Theme.fastctx_gui">
        <item name="android:windowBackground">@color/world_warm_black</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/world_warm_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
    </style>
    <style name="Theme.World.InkBlack" parent="Theme.fastctx_gui">
        <item name="android:windowBackground">@color/world_ink_black</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/world_ink_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
    </style>
    <style name="Theme.World.WarmWhite" parent="Theme.fastctx_gui">
        <item name="android:windowBackground">@color/world_warm_white</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/world_warm_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
    </style>
</resources>
